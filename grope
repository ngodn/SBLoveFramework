#!/usr/bin/env bash
# The milestone: Eve reaching up and cupping her own right breast, as MOTION.
#
#   ./grope            apply the animation
#   ./grope --pose     hold the contact pose still, for measuring
#
# Everything before this wrote one constant rotation to all 129 keys, which is a
# frozen pose, not an animation. --emitanim slerps between waypoints given as
# fractions of the sequence, easing each segment with smoothstep so it starts
# and ends at zero velocity.
#
# Rest is 48:(0,80,0) 49:(0,0,0). That is not a guess: resetting the tracks to
# the shipped idle measured the elbow at (right 18.3, up -13.5) and the hand at
# (right 28.6, up -36.4), and the identity sweep at yaw 80 / flex 0 measured
# (17.5, -14.0) and (23.5, -38.2). Close enough to loop cleanly back into idle.
#
# Contact is 48:(180,85,-20) 49:(0,0,135), from ./armsearch. See docs/anatomy.md
# for why the score has to include the elbow and not just the wrist.
#
# The shape, following the animation principles that matter here:
#   anticipation  a small settle DOWN before the arm comes up
#   ease in/out   smoothstep on every segment; constant velocity reads robotic
#   overshoot     flex passes 135 and relaxes back, so contact has weight
#   knead         a slow cycle while in contact, rather than a dead hold
#   return        back to rest, same rotation as key 0
set -uo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

# Wrist rotation that turns the palm toward the midline, from ./palmsearch.
# Measured: palm faces right -0.92, up +0.20, fwd -0.39, so 2.8 degrees off a
# cupping direction, with the fingers pointing up and slightly inward.
# Unposed the palm faces UP and back, 60.7 degrees off, which on screen reads as
# fingers splayed forward holding an invisible ball.
WRIST="${WRIST:-60 60 45}"

if [ "${1:-}" = "--pose" ]; then
    ./pose 48 180 85 -20 && ./pose 49 0 0 135 && ./pose 50 $WRIST
    exit
fi

ROOT=~/development/mods/stellar-blade
ASSET="$(pwd)/assets/SB/Content/Art/Character/PC/CH_P_EVE_01/Animation/Proto_Idle.uasset"
USMAP="$ROOT/research/StellarBlade_retail_dumped.usmap"
OBJECT_PATH="/Game/Art/Character/PC/CH_P_EVE_01/Animation/Proto_Idle.proto_Idle"
UE4SS="/mnt/eins0fxE/SteamLibrary/steamapps/common/StellarBlade/SB/Binaries/Win64/ue4ss"

addr="$(./sblove animaddr "$OBJECT_PATH" 2>/dev/null | grep -oE 'object=0x[0-9A-Fa-f]+')"
[ -n "$addr" ] || { echo "could not get the object address; is the game running?" >&2; exit 1; }

emit() {                     # emit <track> <waypoint>...
    local track="$1"; shift
    local patch
    patch="$(cd "$ROOT/tools/SBAnimTool" && dotnet run --project . -- \
        "$ASSET" "$USMAP" --emitanim "$track" "$@" 2>/dev/null)"
    grep -q '^bulksize' <<<"$patch" || { echo "track $track failed"; return 1; }
    { echo "$addr"; echo "stamp=$(date +%s%N)"; echo "$patch"; } > "$UE4SS/SBLove_patch.txt"
    grep '^#' <<<"$patch" | sed 's/^/  /'
    sleep 1
}

# Shoulder: settle back a touch, swing the arm up and in, hold, return.
emit 48 0:0,80,0 0.08:0,88,4 0.34:180,85,-20 0.88:180,85,-20 1:0,80,0

# Elbow: extend slightly first (anticipation), fold past the target and relax
# back onto it (overshoot and settle), then knead slowly while in contact.
emit 49 0:0,0,0 0.08:0,0,-9 0.34:0,0,142 0.42:0,0,133 0.56:0,0,141 \
        0.70:0,0,132 0.82:0,0,139 0.88:0,0,135 1:0,0,0

# Wrist: turn the palm in during the reach, hold it through contact, release.
read -r wp wy wr <<<"$WRIST"
emit 50 0:0,0,0 0.30:$wp,$wy,$wr 0.88:$wp,$wy,$wr 1:0,0,0

echo
echo "applied. it loops with the idle, so it plays continuously."
echo "./reset  puts the arm back to the shipped animation."
